# Discord bot token
DISCORD_TOKEN=your_discord_bot_token

# Guild IDs for instant slash-command sync during development (comma-separated)
DEV_GUILD_IDS=123456789012345678

# Discord user IDs allowed to use /config (comma-separated)
CONFIG_DISCORD_IDS=123456789012345678
# Alias for CONFIG_DISCORD_IDS
OWNER_DISCORD_IDS=123456789012345678

# SQLite — локальный файл на диске (создаётся автоматически при первом запуске)
# По умолчанию: RULC-Systems-Operations/data/bot.db
DATABASE_PATH=data/bot.db
